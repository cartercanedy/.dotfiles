// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "ctrl+p",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "-vscode-neovim.send",
    "when": "editorTextFocus && neovim.ctrlKeysNormal.p && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
  },
  {
    "key": "ctrl+y",
    "command": "workbench.action.acceptSelectedQuickOpenItem",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+y",
    "command": "acceptSelectedSuggestion",
    "when": "editorTextFocus && neovim.mode == 'insert'"
  },
  {
    "key": "ctrl+y",
    "command": "acceptSelectedCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+y",
    "command": "list.select",
    "when": "fix"
  },
  {
    "key": "ctrl+n",
    "command": "editor.action.triggerSuggest",
    "when": "editorTextFocus && neovim.mode == 'insert' && !suggestWidgetVisible"
  },
  {
    "key": "ctrl+p",
    "command": "editor.action.triggerSuggest",
    "when": "editorTextFocus && neovim.mode == 'insert' && !suggestWidgetVisible"
  },
  {
    "key": "ctrl-y",
    "command": "list.select",
    "when": "inQuickInput && listFocus"
  },
  {
    "key": "ctrl-n",
    "command": "-workbench.action.files.newUntitledFile",
  },
  {
    "key": "tab",
    "command": "workbench.action.focusLastEditorGroup",
    "when": "inputBoxFocus"
  },
  {
    "key": "enter",
    "command": "-acceptSelectedSuggestion"
  },
  {
    "key": "shift+k",
    "command": "editor.action.showHover",
    "when": "editorTextFocus && neovim.init && neovim.mode == 'normal'"
  },
  {
    "key": "shift+k",
    "command": "-editor.action.showHover",
    "when": "editorHoverVisible && editorTextFocus && neovim.init && neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+y",
    "command": "-redo"
  },
  {
    "key": "tab",
    "command": "-insertSnippet",
    "when": "editorTextFocus && hasSnippetCompletions && !editorTabMovesFocus && !inSnippetMode"
  },
  {
    "key": "tab",
    "command": "-insertNextSuggestion",
    "when": "hasOtherSuggestions && textInputFocus && !inSnippetMode && !suggestWidgetVisible && config.editor.tabCompletion == 'on'"
  },
  {
    "key": "tab",
    "command": "-insertBestCompletion",
    "when": "atEndOfWord && textInputFocus && !hasOtherSuggestions && !inSnippetMode && !suggestWidgetVisible && config.editor.tabCompletion == 'on'"
  },
  {
    "key": "tab",
    "command": "-acceptSelectedSuggestion",
    "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "ctrl+w ctrl+t",
    "command": "terminal.focus",
  },
  {
    "key": "ctrl+w t",
    "command": "terminal.focus",
  },
  {
    "key": "ctrl+w ctrl+e",
    "command": "workbench.action.focusActiveEditorGroup",
  },
  {
    "key": "ctrl+w e",
    "command": "workbench.action.focusActiveEditorGroup",
  },
  {
    "key": "ctrl+up",
    "command": "-workbench.action.terminal.scrollToPreviousCommand",
    "when": "terminalFocus && terminalHasBeenCreated && !accessibilityModeEnabled || terminalFocus && terminalProcessSupported && !accessibilityModeEnabled"
  },
  {
    "key": "ctrl+down",
    "command": "-workbench.action.terminal.focus",
    "when": "accessibilityModeEnabled && accessibleViewOnLastLine && terminalHasBeenCreated && accessibleViewCurrentProviderId == 'terminal' || accessibilityModeEnabled && accessibleViewOnLastLine && terminalProcessSupported && accessibleViewCurrentProviderId == 'terminal'"
  },
  {
    "key": "ctrl+down",
    "command": "-workbench.action.terminal.scrollToNextCommand",
    "when": "terminalFocus && terminalHasBeenCreated && !accessibilityModeEnabled || terminalFocus && terminalProcessSupported && !accessibilityModeEnabled"
  },
]